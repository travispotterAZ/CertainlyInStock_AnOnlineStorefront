{
  "realm": "certainlyinstock",
  "enabled": true,
  "displayName": "CertainlyInStock",
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "verifyEmail": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "actionTokenGeneratedByUserLifespan": 900,
  "passwordPolicy": "length(8)",
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@certainlyinstock.local",
    "fromDisplayName": "CertainlyInStock",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "defaultRole": {
    "name": "default-roles-certainlyinstock",
    "description": "${role_default-roles}",
    "composite": true,
    "clientRole": false
  },
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Store administrator",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "CUSTOMER",
        "description": "Registered customer",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "SERVICE",
        "description": "Internal service accounts (e.g. auth-service creating user profiles)",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "default-roles-certainlyinstock",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": ["offline_access", "uma_authorization", "CUSTOMER"]
        },
        "clientRole": false
      }
    ]
  },
  "clients": [
    {
      "clientId": "certainlyinstock-web",
      "name": "CertainlyInStock Web (frontend)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3000/*", "http://localhost:5173/*"],
      "webOrigins": ["http://localhost:3000", "http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://localhost:5173/*"
      }
    },
    {
      "clientId": "certainlyinstock-api",
      "name": "CertainlyInStock API (dev / Postman)",
      "description": "DEV ONLY: password grant enabled so Postman can fetch tokens. Do not use from a real UI.",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "auth-service",
      "name": "auth-service (service account)",
      "description": "DEV ONLY secret. Override in real environments.",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-auth-service-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "service-account-auth-service",
      "enabled": true,
      "serviceAccountClientId": "auth-service",
      "realmRoles": ["SERVICE"],
      "clientRoles": {
        "realm-management": ["manage-users", "view-users"]
      }
    },
    {
      "username": "admin@certainlyinstock.local",
      "email": "admin@certainlyinstock.local",
      "firstName": "Test",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "admin1234", "temporary": false }
      ],
      "realmRoles": ["ADMIN", "CUSTOMER"]
    },
    {
      "username": "customer@certainlyinstock.local",
      "email": "customer@certainlyinstock.local",
      "firstName": "Test",
      "lastName": "Customer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "customer1234", "temporary": false }
      ],
      "realmRoles": ["CUSTOMER"]
    }
  ]
}
