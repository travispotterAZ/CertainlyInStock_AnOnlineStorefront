        {
          "name": "List users as admin -> 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{userUrl}}/getAll",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const mine = pm.response.json().find(u => u.email === pm.collectionVariables.get(\"newUserEmail\"));",
                  "pm.test(\"Registered user has a profile\", () => pm.expect(mine).to.be.an(\"object\"));",
                  "pm.test(\"Profile is linked to Keycloak\", () => pm.expect(mine.keycloakId).to.eql(pm.collectionVariables.get(\"newUserKeycloakId\")));"
                ]
              }
            }
          ]
        }
      ]
    },
