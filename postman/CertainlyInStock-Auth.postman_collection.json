{
  "info": {
    "name": "CertainlyInStock - Auth (Keycloak)",
    "description": "Authentication, registration, password reset and role checks across all services.\n\nStart the stack (`docker compose up` in parent/), then run the folders in order: folder 1 stores the tokens the others use. Test users and passwords are DEV ONLY (see keycloak/realm-export.json). Reset emails go to Mailpit: http://localhost:8025.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "1. Tokens (Keycloak)",
      "description": "Run first. Gets tokens from Keycloak and stores them in collection variables used by every later request.",
      "item": [
        {
          "name": "Admin login",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{apiClientId}}",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "{{adminUsername}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{adminPassword}}",
                  "type": "text"
                }
              ]
            },
            "description": "Logs in at Keycloak with the password grant (dev/Postman only) and stores the access token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"adminToken\", body.access_token);",
                  "pm.test(\"Has an access token\", () => pm.expect(body.access_token).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Customer login",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{apiClientId}}",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "{{customerUsername}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{customerPassword}}",
                  "type": "text"
                }
              ]
            },
            "description": "Logs in at Keycloak with the password grant (dev/Postman only) and stores the access token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"customerToken\", body.access_token);",
                  "pm.test(\"Has an access token\", () => pm.expect(body.access_token).to.be.a(\"string\"));",
                  "pm.collectionVariables.set(\"customerRefreshToken\", body.refresh_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh customer token",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "refresh_token",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{apiClientId}}",
                  "type": "text"
                },
                {
                  "key": "refresh_token",
                  "value": "{{customerRefreshToken}}",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"customerToken\", body.access_token);",
                  "pm.collectionVariables.set(\"customerRefreshToken\", body.refresh_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Wrong password is rejected",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{apiClientId}}",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "{{customerUsername}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "definitely-wrong",
                  "type": "text"
                }
              ]
            },
            "description": "Keycloak locks an account for 60s after failed logins less than 1s apart. If a correct password suddenly fails, wait a minute."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"invalid_grant\", () => pm.expect(pm.response.json().error).to.eql(\"invalid_grant\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. auth-service (register, me, password reset)",
      "item": [
        {
          "name": "Register a new customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{authUrl}}/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{newUserEmail}}\",\n  \"password\": \"{{newUserPassword}}\",\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Shopper\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Public (no token). Creates the Keycloak user (role CUSTOMER) and the user-service profile."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"Returns the Keycloak id\", () => pm.expect(body.keycloakId).to.be.a(\"string\"));",
                  "pm.test(\"Returns the email\", () => pm.expect(body.email).to.eql(pm.collectionVariables.get(\"newUserEmail\")));",
                  "pm.collectionVariables.set(\"newUserKeycloakId\", body.keycloakId);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"newUserEmail\", `shopper.${Date.now()}@example.com`);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register the same email again -> 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{authUrl}}/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{newUserEmail}}\",\n  \"password\": \"{{newUserPassword}}\",\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Shopper\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register with invalid input -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{authUrl}}/register",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"not-an-email\",\n  \"password\": \"short\",\n  \"firstName\": \"\",\n  \"lastName\": \"Shopper\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "New customer logs in (Keycloak)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{apiClientId}}",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "{{newUserEmail}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{newUserPassword}}",
                  "type": "text"
                }
              ]
            },
            "description": "Logs in at Keycloak with the password grant (dev/Postman only) and stores the access token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"newUserToken\", body.access_token);",
                  "pm.test(\"Has an access token\", () => pm.expect(body.access_token).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I (new customer)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{authUrl}}/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{newUserToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Same id as registration\", () => pm.expect(body.keycloakId).to.eql(pm.collectionVariables.get(\"newUserKeycloakId\")));",
                  "pm.test(\"Has CUSTOMER role\", () => pm.expect(body.roles).to.include(\"CUSTOMER\"));",
                  "pm.test(\"Is not ADMIN\", () => pm.expect(body.roles).to.not.include(\"ADMIN\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I without a token -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{authUrl}}/me",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Request password reset (existing account) -> 202",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{authUrl}}/password-reset",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{newUserEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Always 202 with no body. If the account exists, Keycloak emails a reset link: open Mailpit at http://localhost:8025."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 202\", () => pm.response.to.have.status(202));",
                  "pm.test(\"Empty body\", () => pm.expect(pm.response.text()).to.eql(\"\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Request password reset (unknown account) -> same 202",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{authUrl}}/password-reset",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nobody.{{$timestamp}}@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Identical response to an existing account, so the endpoint cannot be used to find out who is registered."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 202\", () => pm.response.to.have.status(202));",
                  "pm.test(\"Empty body\", () => pm.expect(pm.response.text()).to.eql(\"\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Request password reset (malformed email) -> 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{authUrl}}/password-reset",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"not-an-email\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
