    {
      "name": "5. cart-service",
      "item": [
        {
          "name": "Get cart without a token -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{cartUrl}}/users/{{cartUserId}}/cart",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get cart as customer -> 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{cartUrl}}/users/{{cartUserId}}/cart",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Owner checks are not implemented yet: any customer can read any cart id."
          },
          "event": [
            {
              "listen": "test",
              "script": {
