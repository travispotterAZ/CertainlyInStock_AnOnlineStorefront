  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{adminToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Keep a valid admin token in {{adminToken}}. Keycloak access tokens last 5 minutes, and a",
          "// resource server rejects an expired token with 401 even on public endpoints.",
          "const expiresAt = Number(pm.collectionVariables.get('adminTokenExpiresAt') || 0);",
          "const haveToken = !!pm.collectionVariables.get('adminToken');",
          "if (!haveToken || Date.now() > expiresAt - 30000) {",
          "  pm.sendRequest({",
          "    url: pm.variables.replaceIn('{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token'),",
          "    method: 'POST',",
          "    header: { 'Content-Type': 'application/x-www-form-urlencoded' },",
          "    body: {",
          "      mode: 'urlencoded',",
          "      urlencoded: [",
          "        { key: 'grant_type', value: 'password' },",
          "        { key: 'client_id', value: pm.variables.replaceIn('{{apiClientId}}') },",
          "        { key: 'username', value: pm.variables.replaceIn('{{adminUsername}}') },",
          "        { key: 'password', value: pm.variables.replaceIn('{{adminPassword}}') }",
          "      ]",
          "    }",
          "  }, (err, res) => {",
          "    if (err || res.code !== 200) {",
          "      throw new Error('Could not get an admin token from Keycloak: ' + (err || res.code + ' ' + res.text()));",
          "    }",
          "    const body = res.json();",
          "    pm.collectionVariables.set('adminToken', body.access_token);",
          "    pm.collectionVariables.set('adminTokenExpiresAt', String(Date.now() + body.expires_in * 1000));",
          "  });",
          "}"
        ]
      }
    }
  ],
